<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ rules for device-to-device transfer (allowBackup false turns cloud backup off, but not
  transfer) and for cloud backup if that is turned on again. The secure storage prefs
  (flutter_secure_storage 11.2.0, default options) hold ciphertext whose Keystore key is never backed
  up, so both sections exclude them. The pear-corestore and pear-bulk excludes repeat flutter_pear_bare's,
  because this file replaces its rules (tools:replace in AndroidManifest.xml).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <exclude domain="file" path="pear-corestore"/>
        <exclude domain="file" path="pear-bulk"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml"/>
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml"/>
        <exclude domain="file" path="pear-corestore"/>
        <exclude domain="file" path="pear-bulk"/>
    </device-transfer>
</data-extraction-rules>
